PORT=3000

# Supabase: Settings > API Keys (o botón "Connect" del proyecto)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
# Secret key (sb_secret_...). SOLO en el backend, nunca en React ni en GitHub.
SUPABASE_SECRET_KEY=sb_secret_pega_aqui_tu_clave

# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia_esto_por_una_cadena_larga_y_aleatoria
JWT_EXPIRES_IN=2h

# Origen(es) del frontend permitidos por CORS (separados por coma)
FRONTEND_URL=http://localhost:5173

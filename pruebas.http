# ==============================================================
#  PRUEBAS DE LA API  -  SENATI TEC
#  Extensión de VS Code: "REST Client" (humao.rest-client)
#  Pulsa "Send Request" sobre cada petición, EN ORDEN.
#  Requiere haber cargado los datos de ejemplo (02_datos.sql).
# ==============================================================

@host = http://localhost:3000/api


###################### 1. SALUD ######################

### Servidor vivo
GET {{host}}/health


###################### 2. AUTENTICACIÓN ######################

### Registro de un cliente nuevo (email aleatorio) -> 201
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nombre": "Cliente de Prueba",
  "email": "cliente{{$randomInt 1000 9999}}@correo.com",
  "password": "Clave1234",
  "telefono": "987654321"
}

### Registro con datos inválidos -> 400
POST {{host}}/auth/registro
Content-Type: application/json

{ "nombre": "A", "email": "no-es-email", "password": "123" }

### Registro con email repetido -> 409
POST {{host}}/auth/registro
Content-Type: application/json

{ "nombre": "Ana Repetida", "email": "ana@correo.com", "password": "Clave1234" }

### Registro intentando ser admin: el campo "rol" se IGNORA -> 201 con rol "cliente"
POST {{host}}/auth/registro
Content-Type: application/json

{
  "nombre": "Intruso",
  "email": "intruso{{$randomInt 1000 9999}}@correo.com",
  "password": "Clave1234",
  "rol": "admin"
}

### LOGIN ADMIN (ejecuta este primero: guarda el token) -> 200
# @name loginAdmin
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "admin@tiendatech.com", "password": "Admin123!" }

###
@tokenAdmin = {{loginAdmin.response.body.$.token}}

### LOGIN CLIENTE (Ana) -> 200
# @name loginCliente
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "ana@correo.com", "password": "Cliente123!" }

###
@tokenCliente = {{loginCliente.response.body.$.token}}

### Login con contraseña incorrecta -> 401
POST {{host}}/auth/login
Content-Type: application/json

{ "email": "ana@correo.com", "password": "ClaveMala99" }

### Perfil con token -> 200
GET {{host}}/auth/perfil
Authorization: Bearer {{tokenCliente}}

### Perfil sin token -> 401
GET {{host}}/auth/perfil


###################### 3. CATEGORÍAS ######################

### Listar (público) -> 200
GET {{host}}/categorias

### Obtener una -> 200
GET {{host}}/categorias/1

### Obtener inexistente -> 404
GET {{host}}/categorias/999

### Crear (admin) -> 201
# @name crearCategoria
POST {{host}}/categorias
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "nombre": "Monitores {{$randomInt 100 999}}", "descripcion": "Pantallas y monitores" }

###
@catId = {{crearCategoria.response.body.$.id}}

### Crear como CLIENTE -> 403
POST {{host}}/categorias
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{ "nombre": "Hackeada" }

### Crear sin token -> 401
POST {{host}}/categorias
Content-Type: application/json

{ "nombre": "Sin token" }

### Crear con nombre repetido -> 409
POST {{host}}/categorias
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "nombre": "Laptops" }

### Editar (admin) -> 200
PUT {{host}}/categorias/{{catId}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "descripcion": "Monitores gamer y de oficina" }

### Eliminar la categoría recién creada (admin) -> 200
DELETE {{host}}/categorias/{{catId}}
Authorization: Bearer {{tokenAdmin}}

### Eliminar categoría que tiene productos -> 409 (integridad referencial)
DELETE {{host}}/categorias/1
Authorization: Bearer {{tokenAdmin}}


###################### 4. PRODUCTOS ######################

### Listar (público, con categoría incluida) -> 200
GET {{host}}/productos

### Filtrar por categoría -> 200
GET {{host}}/productos?categoria=2

### Buscar por texto -> 200
GET {{host}}/productos?q=lenovo

### Paginación -> 200
GET {{host}}/productos?pagina=1&limite=3

### Obtener uno -> 200
GET {{host}}/productos/1

### Obtener inexistente -> 404
GET {{host}}/productos/999

### Crear (admin) -> 201
# @name crearProducto
POST {{host}}/productos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{
  "categoria_id": 3,
  "nombre": "Webcam C920",
  "marca": "Logitech",
  "descripcion": "Cámara Full HD con micrófono",
  "precio": 349.90,
  "stock": 12,
  "imagen_url": "https://placehold.co/400x300?text=Webcam"
}

###
@prodId = {{crearProducto.response.body.$.id}}

### Crear con datos inválidos -> 400
POST {{host}}/productos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "categoria_id": 3, "nombre": "x", "precio": -10, "stock": 1.5 }

### Crear con categoría inexistente -> 409
POST {{host}}/productos
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "categoria_id": 999, "nombre": "Producto huérfano", "precio": 100 }

### Crear como CLIENTE -> 403
POST {{host}}/productos
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{ "categoria_id": 3, "nombre": "Producto hackeado", "precio": 1 }

### Editar parcialmente (solo precio y stock) -> 200
PUT {{host}}/productos/{{prodId}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "precio": 299.90, "stock": 20 }

### Editar sin enviar nada -> 400
PUT {{host}}/productos/{{prodId}}
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{}

### Eliminar (desactiva el producto) -> 200
DELETE {{host}}/productos/{{prodId}}
Authorization: Bearer {{tokenAdmin}}

### Ya no aparece en el catálogo público -> 404
GET {{host}}/productos/{{prodId}}

### Eliminar como CLIENTE -> 403
DELETE {{host}}/productos/1
Authorization: Bearer {{tokenCliente}}


###################### 5. PEDIDOS ######################
# Requiere haber ejecutado 04_pedidos.sql en Supabase.
# El cliente envía SOLO producto y cantidad: el precio y el total los calcula la base de datos.

### Crear pedido como cliente (Ana) -> 201, estado "pendiente", stock descontado
# @name crearPedido
POST {{host}}/pedidos
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "direccion_envio": "Av. Túpac Amaru 1234, Independencia, Lima",
  "items": [
    { "producto_id": 3, "cantidad": 1 },
    { "producto_id": 5, "cantidad": 2 }
  ]
}

###
@pedidoId = {{crearPedido.response.body.$.id}}

### Sin stock suficiente -> 409 (no se guarda nada)
POST {{host}}/pedidos
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "direccion_envio": "Av. Túpac Amaru 1234, Independencia, Lima",
  "items": [ { "producto_id": 4, "cantidad": 50 } ]
}

### Datos inválidos (sin productos, dirección corta) -> 400
POST {{host}}/pedidos
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{ "direccion_envio": "corta", "items": [] }

### Producto inexistente -> 409
POST {{host}}/pedidos
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "direccion_envio": "Av. Túpac Amaru 1234, Independencia, Lima",
  "items": [ { "producto_id": 999, "cantidad": 1 } ]
}

### Crear pedido sin token -> 401
POST {{host}}/pedidos
Content-Type: application/json

{ "direccion_envio": "Av. Túpac Amaru 1234, Lima", "items": [ { "producto_id": 1, "cantidad": 1 } ] }

### Mis pedidos (solo los de Ana) -> 200
GET {{host}}/pedidos/mis-pedidos
Authorization: Bearer {{tokenCliente}}

### Ver un pedido propio -> 200
GET {{host}}/pedidos/{{pedidoId}}
Authorization: Bearer {{tokenCliente}}

### Ana intenta ver el pedido 2 (es de Luis) -> 404
GET {{host}}/pedidos/2
Authorization: Bearer {{tokenCliente}}

### Ana intenta listar TODOS los pedidos -> 403
GET {{host}}/pedidos
Authorization: Bearer {{tokenCliente}}

### Admin lista todos los pedidos (con datos del cliente) -> 200
GET {{host}}/pedidos
Authorization: Bearer {{tokenAdmin}}

### Admin filtra por estado + paginación -> 200
GET {{host}}/pedidos?estado=pendiente&pagina=1&limite=5
Authorization: Bearer {{tokenAdmin}}

### Admin ve cualquier pedido -> 200
GET {{host}}/pedidos/2
Authorization: Bearer {{tokenAdmin}}

### Cliente intenta cambiar el estado -> 403
PUT {{host}}/pedidos/{{pedidoId}}/estado
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{ "estado": "pagado" }

### Estado inválido -> 400
PUT {{host}}/pedidos/{{pedidoId}}/estado
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "estado": "volando" }

### Salto no permitido (pendiente -> entregado) -> 409
PUT {{host}}/pedidos/{{pedidoId}}/estado
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "estado": "entregado" }

### Admin: pendiente -> pagado -> 200
PUT {{host}}/pedidos/{{pedidoId}}/estado
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "estado": "pagado" }

### Admin: pagado -> enviado -> 200
PUT {{host}}/pedidos/{{pedidoId}}/estado
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "estado": "enviado" }

### Admin: enviado -> entregado -> 200
PUT {{host}}/pedidos/{{pedidoId}}/estado
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "estado": "entregado" }

### Un pedido entregado ya no se puede cancelar -> 409
PUT {{host}}/pedidos/{{pedidoId}}/estado
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "estado": "cancelado" }

### Crear otro pedido para probar la CANCELACIÓN (devuelve el stock)
# @name crearPedido2
POST {{host}}/pedidos
Authorization: Bearer {{tokenCliente}}
Content-Type: application/json

{
  "direccion_envio": "Av. Túpac Amaru 1234, Independencia, Lima",
  "items": [ { "producto_id": 6, "cantidad": 3 } ]
}

###
@pedidoId2 = {{crearPedido2.response.body.$.id}}

### Stock del producto 6 (bajó en 3)
GET {{host}}/productos/6

### Admin cancela el pedido -> 200
PUT {{host}}/pedidos/{{pedidoId2}}/estado
Authorization: Bearer {{tokenAdmin}}
Content-Type: application/json

{ "estado": "cancelado" }

### Stock del producto 6 (volvió a subir en 3)
GET {{host}}/productos/6
